# Checkout externo HTTPS. Vazio mantém o pré-lançamento sem cobranças.
NEXT_PUBLIC_CHECKOUT_URL=
# Alternativa opcional: canal oficial HTTPS para interesse (sem checkout próprio).
NEXT_PUBLIC_INTEREST_URL=
# Data real ISO 8601 COM fuso, por exemplo 2026-12-01T23:59:59-03:00. Nunca fictícia.
NEXT_PUBLIC_OFFER_END_AT=
# Arquivo de vídeo MP4/WebM HTTPS. Vazio mostra uma prévia estática.
NEXT_PUBLIC_DEMO_VIDEO_URL=
# Rastreamento desligado por padrão; exige consentimento e política publicada.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TERMS_URL=
NEXT_PUBLIC_PRIVACY_URL=
NEXT_PUBLIC_SUPPORT_URL=
